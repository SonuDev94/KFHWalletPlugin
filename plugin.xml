        <source-file src="src/android/model/TokenConfigurationListModel.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/model" />
        <!-- util -->
        <source-file src="src/android/utils/RxJavaThreadingExtensions.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/utils" />
        <source-file src="src/android/utils/NetworkCheck.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/utils" />
        <source-file src="src/android/utils/AppLogger.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/utils" />
        <source-file src="src/android/utils/Currencies.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/utils" />
        <source-file src="src/android/utils/Hex.java"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/utils" />

        <!-- error handing -->
        <source-file src="src/android/error/Error.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/error" />
        <source-file src="src/android/error/ErrorResolver.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/error" />
        <source-file src="src/android/error/ResourcesBasedErrorResolver.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/error" />


        <!-- usecase -->
        <source-file src="src/android/enrollment/EnrollmentManager.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/enrollment" />
        <!-- <source-file
            src="libs/wa-api-kmp-ebc-googleServices-1.1.26-stg-ebc-onprem-all.aar"
            target-dir="libs" /> -->

        <source-file
            src="libs/wa-api-kmp-ebc-googleServices-1.1.33-stg-ebc-onprem-all.aar"
            target-dir="libs" />

        <source-file
