<?xml version='1.0' encoding='utf-8'?>
<plugin id="com.aub.mobilebanking.phone.eg" version="1.0.0"
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>KFHWalletPlugin</name>

     <!-- Engines: required versions -->
     <engines>
        <engine name="cordova" version=">=12.0.0" />
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>


    <js-module name="KFHWalletPlugin" src="www/KFHWalletPlugin.js">
        <clobbers target="cordova.plugins.KFHWalletPlugin" />
    </js-module>

    <hook type="after_prepare" src="hooks/after_prepare/001-fix-finalizer-permissions.js" />
    <hook type="after_prepare" src="hooks/after_prepare/020-add-finalizer-buildscript.js" />
    <hook type="after_prepare" src="hooks/after_prepare/030-set-application-class.js" />

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="KFHWalletPlugin">
                <preference name="GradlePluginKotlinEnabled" value="true" />
                <preference name="GradlePluginGoogleServicesEnabled" value="true" />
                <param name="android-package" value="com.aub.mobilebanking.phone.eg.KFHWalletPlugin" />
            </feature>
        </config-file>

        <source-file
            src="google-services.json"
            target-dir="app" />

        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.NFC" />
            <uses-feature android:name="android.hardware.nfc" android:required="true" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>

       <!-- <edit-config
            file="AndroidManifest.xml"
            mode="merge"
            target="/manifest/application">
            <application android:name="com.aub.mobilebanking.phone.eg.WaAppSystemContext" />
        </edit-config> -->

        <!-- <config-file
    target="AndroidManifest.xml"
    mode="merge"
    parent="/manifest">

    <application
        android:name="com.aub.mobilebanking.phone.eg.WaAppSystemContext" />

</config-file> -->

        <!-- APDU Service -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service
                android:name="com.idemia.wa.api.nfc.WaApduService"
                android:exported="true"
                android:permission="android.permission.BIND_NFC_SERVICE">
                <intent-filter>
                    <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                    <category android:name="android.intent.category.DEFAULT" />
                </intent-filter>
                <meta-data
                    android:name="android.nfc.cardemulation.host_apdu_service"
                    android:resource="@xml/aid_list" />
            </service>


            <!-- <service android:name="com.aub.mobilebanking.phone.eg.fcm.WaFirebaseMessagingService"
                android:exported="false">
                <intent-filter>
                    <action android:name="com.google.firebase.MESSAGING_EVENT" />
                </intent-filter>
            </service> -->

            <!-- Receiver for updates -->
            <receiver
                android:name="com.idemia.wa.api.WaPackageReplacedReceiver"
                android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                </intent-filter>
            </receiver>

        </config-file>

        <!-- Copy aid_list.xml into app's res/xml -->
        <resource-file src="src/android/res/xml/aid_list.xml" target="res/xml/aid_list.xml" />
        <resource-file src="src/android/res/values/my_plugin_strings.xml"
            target="res/values/my_plugin_strings.xml" />

        <!-- ProGuard/R8 rules to keep BouncyCastle's provider registration
             (prevents "BKS not found" / KeyStoreException on minified builds) -->
        <resource-file src="proguard/kfhwallet-proguard-rules.pro"
            target="app/kfhwallet-proguard-rules.pro" />

        
        <source-file src="src/android/WaAppSystemContext.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg" />

        <source-file src="src/android/KFHWalletPlugin.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg" />
        <!-- data -->
        <source-file src="src/android/data/CardArtStorage.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/data" />
        <!-- repository -->
        <source-file src="src/android/repository/DefaultWaServicesRepository.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/repository" />
        <source-file src="src/android/repository/WaServicesRepository.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/repository" />
        <source-file src="src/android/repository/WaServicesProvider.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/repository" />
        <source-file src="src/android/repository/CardArtRepository.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/repository" />
        <source-file src="src/android/repository/DefaultCardArtRepository.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/repository" />

        <!-- model -->
        <source-file src="src/android/model/EnrollmentData.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/model" />
        <source-file src="src/android/model/ExpirationDateEnrollmentData.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/model" />
        <source-file src="src/android/model/CdCvmOption.kt"
            target-dir="app/src/main/java/com/aub/mobilebanking/phone/eg/model" />
        <source-file src="src/android/model/HomeViewCardToken.kt"
