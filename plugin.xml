            target-dir="libs" />

        <!-- Maven dependencies -->
        <framework src="com.google.android.gms:play-services-base:18.7.2" />
        <framework src="androidx.lifecycle:lifecycle-viewmodel-ktx:2.9.2" />
        <framework src="org.slf4j:slf4j-api:2.0.16" />
        <framework src="io.reactivex.rxjava3:rxandroid:3.0.2" />
        <framework src="com.github.tony19:logback-android:3.0.0" />
        <framework src="com.squareup.okhttp3:logging-interceptor:4.9.1" />
        <framework src="org.bouncycastle:bcprov-jdk18on:1.77" />
        <framework src="com.squareup.retrofit2:retrofit:2.11.0" />
        <framework src="com.squareup.retrofit2:converter-jackson:2.11.0" />
        <framework src="com.squareup.retrofit2:converter-scalars:2.11.0" />
        <framework src="com.google.firebase:firebase-core:21.1.1" />
        <framework src="com.google.firebase:firebase-messaging:24.0.1" />
        <framework src="androidx.work:work-runtime-ktx:2.10.1" />
        <framework src="com.google.android.play:integrity:1.4.0" />
        <framework src="com.fasterxml.uuid:java-uuid-generator:5.1.0" />
        <framework src="com.fasterxml.jackson.core:jackson-databind:2.17.2" />
        <framework src="com.squareup.okhttp3:okhttp:4.9.1" />
        <framework src="androidx.annotation:annotation:1.8.2" />
        <framework src="com.neovisionaries:nv-i18n:1.24" />
        <framework src="org.jetbrains.kotlin:kotlin-reflect:2.0.20" />
        <framework src="org.jetbrains.kotlin:kotlin-stdlib:2.0.20" />
        <framework src="com.google.code.gson:gson:2.10.1" />
        <framework src="androidx.biometric:biometric:1.1.0" />
        <framework src="com.google.gms:google-services:4.4.2" type="gradlePlugin" />
        <framework src="com.squareup.moshi:moshi-kotlin:1.15.2" />
        <framework src="com.ionspin.kotlin:bignum:0.3.10" />
        <framework src="com.fasterxml.jackson.module:jackson-module-kotlin:2.17.2" />


        <!-- Gradle hook-->
        <resource-file
            src="scripts/build.gradle"
            target="app/build.gradle"
            merge="true" />
        <framework src="scripts/build.gradle" custom="true" type="gradleReference" />

        <!-- <resource-file
